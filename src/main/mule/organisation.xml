				</ee:set-variable>
				<ee:set-variable variableName="orgId"><![CDATA[%dw 2.0
					output application/java
					---
					attributes.uriParams.'orgId' ]]>
				</ee:set-variable>
				<ee:set-variable variableName="userId"><![CDATA[%dw 2.0
					output application/java
					---
					if (lower(attributes.headers.'userId') == p('account.dummy.userId')) vars.clientId else lower(attributes.headers.'userId') ]]>
				</ee:set-variable>
				<ee:set-variable variableName="filterBy"><![CDATA[%dw 2.0
					import contactType from dwl::modules
					output application/json
					---
					{
						contactType: ((attributes.queryParams.*filterByContactType) map (contactType($))) default [],
						orgUnitId: (attributes.queryParams.*filterByOrgUnitId) default []
					}]]>
				</ee:set-variable>
				<ee:set-variable variableName="sortBy"><![CDATA[attributes.queryParams.*sortBy]]></ee:set-variable>
				<ee:set-variable variableName="sortType"><![CDATA[attributes.queryParams.sortType]]></ee:set-variable>
				<ee:set-variable variableName="messageQuery"><![CDATA[%dw 2.0
					import * from dw::core::URL
					output application/json encoding="UTF-8"
					---
					if(!isEmpty(attributes.queryParams.messageQuery)) (decodeURIComponent(attributes.queryParams.messageQuery)) else null ]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="StartLog" doc:id="e82f06a9-dba0-4383-9c88-bb05d3c4acf0" name="commonLoggingEntrySubFlow" />
		<flow-ref doc:name="CheckUserDetails" doc:id="47ce3c6f-14e3-4cc7-8f67-c7407e3475b6" name="userDetailsSubFlow" target="userIdDetails" />
		<ee:transform doc:name="SqlVars" doc:id="3f28fa70-9f41-4199-abab-bbe6a84e3797">
			<ee:variables>
				<ee:set-variable variableName="contactsQp"><![CDATA[%dw 2.0
					import sortQuery from dwl::modules
					output application/java
					var sortBy = if (!isEmpty(vars.sortBy)) (vars.sortBy) else []
					var sortType = if (!isBlank(vars.sortType)) (upper(vars.sortType)) else 'DESC'
					---
					sortQuery: sortQuery(sortBy,sortType,'getContacts') ]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="DynamicQuery" doc:id="870fd386-024e-4781-80c6-7871a759698a">
			<ee:variables>
				<ee:set-variable variableName="contactsSelectQuery"><![CDATA[%dw 2.0
					import contactType from dwl::modules
					output application/java
					var query = p('db.query.select.getContactsByOrgId')
					fun msgLikeQuery(columnName,val) = columnName ++ " LIKE '%" ++ val ++ "%'"
					var messageQuery = if (!isBlank(vars.messageQuery))
					( "AND (" ++ msgLikeQuery("((CO.SUB_CODE_NAME +' ('+ ISNULL(CC.ORG_UNIT_ID,''))+')')",vars.messageQuery) ++ ' OR ' ++
					msgLikeQuery('CC.CONTACT_DEPT',vars.messageQuery) ++ ' OR ' ++
					msgLikeQuery('CC.CONTACT_EMAIL',vars.messageQuery) ++ ' OR ' ++
					msgLikeQuery('(CC.CONTACT_FORENAME+' ++ "' '" ++ '+CC.CONTACT_SURNAME)',vars.messageQuery) ++ ' '++
					(if (!isBlank(contactType(vars.messageQuery))) msgLikeQuery(' OR CC.CONTACT_TYPE',contactType(vars.messageQuery))
					else '' ) ++ ' OR ' ++
					(msgLikeQuery('CO.SUB_CODE_NAME',vars.messageQuery)) ++ ")" ) else ''
					var contactTypeValue = if (!isEmpty(vars.filterBy.contactType)) ( "AND CC.CONTACT_TYPE IN ('" ++ (vars.filterBy.contactType joinBy "','") ++ "')" )
					else ( "AND CC.CONTACT_TYPE IN ('" ++ (["P","L","A","S","D"] joinBy "','") ++ "')" )
					var orgUnitId = if (!isEmpty(vars.filterBy.orgUnitId)) ( "AND CC.ORG_UNIT_ID IN ('" ++ (vars.filterBy.orgUnitId joinBy "','") ++ "')" ) else ''
					var sortQuery = vars.contactsQp.sortQuery
					---
					((((query replace ':messageQuery' with(messageQuery)) replace ':contactType' with(contactTypeValue)) replace ':branch' with(orgUnitId)) replace
					':sortQuery' with(sortQuery))]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="StartDurationLog" doc:id="6c421bc9-278e-4912-a3de-8fb34dc657d7" name="startDurationLogSubFlow" />
		<db:select doc:name="GetContacts" doc:id="b1b5fd4b-3bb6-43ed-b675-9be5f1723a86" config-ref="azureSqlDatabaseConfig">
			<db:sql><![CDATA[#[vars.contactsSelectQuery]]]></db:sql>
			<db:input-parameters><![CDATA[#[{
				orgId: vars.orgId,
				offset: vars.pagination.offset - 1,
				limit: vars.pagination.limit }] ]]>
			</db:input-parameters>
		</db:select>
