	<!-- GET ORG BRANCH LIST SUB FLOW -->
	<sub-flow name="getOrgBranchListSubFlow" doc:id="2a6b57e7-fcff-411e-b5d3-e38bb3733f99">
		<ee:transform doc:name="Entity" doc:id="39dd77e9-129c-4afd-85fa-a1396578d248">
			<ee:variables>
				<ee:set-variable variableName="entity"><![CDATA[%dw 2.0
					output application/java
					---
					'getBranchList']]>
				</ee:set-variable>
				<ee:set-variable variableName="extApiName"><![CDATA[%dw 2.0
					output application/java
					---
					p('external.azuresql.customer')]]>
				</ee:set-variable>
				<ee:set-variable variableName="orgId"><![CDATA[%dw 2.0
					output application/java
					---
					attributes.uriParams.'orgId' ]]>
				</ee:set-variable>
				<ee:set-variable variableName="userId"><![CDATA[%dw 2.0
					output application/java
					---
					if (lower(attributes.headers.'userId') == p('account.dummy.userId')) vars.clientId else lower(attributes.headers.'userId') ]]>
				</ee:set-variable>
				<ee:set-variable variableName="branchParams"><![CDATA[%dw 2.0
					output application/java
					var sortby = (attributes.queryParams.*sortBy)
					var sorttype = attributes.queryParams.sortType
					var sort = sortby map ((item, index) -> item ++ " " ++ ( sorttype default "ASC" ))
					var messageQuery = attributes.queryParams.messageQuery default ""
					---
					{
						messageQuery: messageQuery ,
						sortBy: (sort joinBy ','),
						status: (attributes.queryParams.*status map "$" joinBy ",") default null,
						service: (attributes.queryParams.*service map "$" joinBy ",") default null
					}]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="StartLog" doc:id="54b0b1b4-9fc0-4df4-8305-68c01a2ab497" name="commonLoggingEntrySubFlow" />
		<flow-ref doc:name="CheckUserDetails" doc:id="647d3e0d-565d-4308-b502-1820f5ed6375" name="userDetailsSubFlow" target="userIdDetails" />
		<ee:transform doc:name="SqlVars" doc:id="bb0490b4-7e9a-4231-93f1-af5ffe1ec9cb" >
			<ee:variables>
				<ee:set-variable variableName="searchFilter" ><![CDATA[%dw 2.0
					output application/json
					var col = ["BRANCH_NAME","POSTCODE","STATUS","ACTING_ON_BEHALF_OF","CONTACT_TEL","SERVICE","LAW_SOCIETY_CODE","BRANCH_ID"]
					---
					{
						searchCol: if(!isBlank(vars.branchParams.messageQuery)) ((col map(data,index)-> data ++ " LIKE '%" ++
						vars.branchParams.messageQuery ++ "%'")joinBy " OR ")  else null
					}]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="getOrgBranchList" doc:id="bff20dc4-b489-485b-9947-dfc4dcf74733" name="getOrgBranchListSubFlow" />
