	<flow name="azure-sys-api-main">
		<http:listener config-ref="httpListenerConfig" path="${https.listener.path}">
			<http:response statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<ee:transform doc:name="CommonAttributes" doc:id="4455c394-c1c7-4c4e-9d4c-4376bc289fc7">
			<ee:variables>
				<ee:set-variable variableName="txnId"><![CDATA[%dw 2.0
					output application/java
					---
					if (attributes.headers.'x-transaction-id' != null)
						attributes.headers.'x-transaction-id' as String
					else attributes.headers.'x-correlation-id']]>
				</ee:set-variable>
				<ee:set-variable variableName="contentType"><![CDATA[%dw 2.0
					output application/java
					---
					attributes.'accept']]>
				</ee:set-variable>
				<ee:set-variable variableName="apiName"><![CDATA[%dw 2.0
					output application/java
					---
					attributes.'requestUri']]>
				</ee:set-variable>
				<ee:set-variable variableName="operation"><![CDATA[%dw 2.0
					output application/java
					---
					upper(attributes.method)]]>
				</ee:set-variable>
				<ee:set-variable variableName="host"><![CDATA[%dw 2.0
					output application/java
					---
					attributes.headers.host]]>
				</ee:set-variable>
				<ee:set-variable variableName="scheme"><![CDATA[%dw 2.0
					output application/java
					---
					attributes.scheme]]>
				</ee:set-variable>
				<ee:set-variable variableName="pagination"><![CDATA[%dw 2.0
					output application/java
					---
					{
						offset: attributes.queryParams.offset default 1,
						limit: attributes.queryParams.limit default 100,
						relativePath: attributes.'relativePath'
					}]]>
				</ee:set-variable>
				<ee:set-variable variableName="clientIp"><![CDATA[%dw 2.0
					output application/java
					---
					attributes.headers.'clientIp']]>
				</ee:set-variable>
				<ee:set-variable variableName="clientId"><![CDATA[%dw 2.0
					output application/java
					---
					attributes.headers.'clientId']]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<apikit:router config-ref="azure-sys-api-config" />
		<error-handler ref="apiErrorHandler" />
	</flow>

