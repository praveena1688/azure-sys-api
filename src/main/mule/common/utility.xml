	<!-- SEND EMAIL -->
	<sub-flow name="sendEmailSubFlow">
		<choice doc:name="isValidRequest" doc:id="44a1b367-f3b0-450a-8554-50da894dd669">
			<when expression="#[!isEmpty(payload.emailRequest.toAddress)]">
				<ee:transform doc:name="SendEmailReq" doc:id="650c1e69-184d-457c-bb29-dbddd533d148">
					<ee:variables>
						<ee:set-variable variableName="systemapi"><![CDATA[%dw 2.0
							output application/java
							---
							{
								host: p('secure::systemapi.utility.host'),
								port: p('secure::systemapi.utility.port'),
								basePath: p('systemapi.utility.basePath') default '',
								entityPath: p('systemapi.utility.path.notifications.email'),
								clientId: p('secure::systemapi.utility.clientId'),
								clientSecret: p('secure::systemapi.utility.clientSecret')
							}]]>
						</ee:set-variable>
						<ee:set-variable variableName="httpMethod"><![CDATA[%dw 2.0
							output application/java
							---
							'POST']]>
						</ee:set-variable>
						<ee:set-variable variableName="extApiName"><![CDATA[%dw 2.0
							output application/java
							---
							p('external.systemapi.utility.notifications')]]>
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="SystemApiCall" doc:id="52abd614-9139-446a-84b4-167a4966244a" name="systemApiCallSubFlow" />
			</when>
			<otherwise>
				<ee:transform doc:name="LogVars" doc:id="500e86b8-f6c2-46c5-806a-9118c284f9a7">
					<ee:variables>
						<ee:set-variable variableName="message"><![CDATA[%dw 2.0
							output text/plain
							---
							'INVALID EMAIL REQUEST: ' ++ write(payload,'application/json') ]]>
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="commonLoggingPayloadSubFlow" doc:id="d61884ad-e93a-4f35-87eb-a20b73d1a924" name="commonLoggingPayloadSubFlow" />
			</otherwise>
		</choice>
	</sub-flow>

	<!-- UKVD TVI CODE LOOKUP -->
	<sub-flow name="tviCodeLookupSubFlow">
		<ee:transform doc:name="TviCodeReq" doc:id="267b7004-5c33-48ad-8580-822a33cef499">
			<ee:variables>
				<ee:set-variable variableName="cacheKey"><![CDATA[%dw 2.0
					output application/java
					---
					vars.tviCode]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<!-- <ee:cache doc:name="InStepCode" doc:id="53ce9dc7-5873-4b91-a292-6ebf401130d4" cachingStrategy-ref="CachingStrategy"> -->
		<ee:transform doc:name="TviCodeReq" doc:id="2eadfe0c-fe3b-4548-8189-bb880cd0c916">
			<ee:variables>
				<ee:set-variable variableName="systemapi"><![CDATA[%dw 2.0
					output application/java
					---
					{
						host: p('secure::systemapi.utility.host'),
						port: p('secure::systemapi.utility.port'),
						basePath: p('systemapi.utility.basePath') default '',
						entityPath: p('systemapi.utility.path.ukvehicledata.tviCodeLookup') ++ '/' ++ vars.tviCode,
						clientId: p('secure::systemapi.utility.clientId'),
						clientSecret: p('secure::systemapi.utility.clientSecret')
					}]]>
				</ee:set-variable>
				<ee:set-variable variableName="httpMethod"><![CDATA[%dw 2.0
					output application/java
					---
					'GET']]>
				</ee:set-variable>
				<ee:set-variable variableName="extApiName"><![CDATA[%dw 2.0
					output application/java
					---
					p('external.systemapi.utility.ukvd')]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="TviCodeSystemApiCall" doc:id="487218cf-55e4-4e70-8598-a9a8f23ae872" name="systemApiCallSubFlow" />
		<!-- </ee:cache> -->
	</sub-flow>

</mule>
