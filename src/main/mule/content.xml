http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<!-- GET TC SUB FLOW -->
	<sub-flow name="getTcAgreementsSubFlow" doc:id="73374b75-1122-4129-b4dc-7e3b5ad80a6a">
		<ee:transform doc:name="Entity" doc:id="2351e43a-666e-4809-bc6a-6bc74d450725">
			<ee:variables>
				<ee:set-variable variableName="entity"><![CDATA[%dw 2.0
					output application/java
					---
					'getTcAgreements']]>
				</ee:set-variable>
				<ee:set-variable variableName="extApiName"><![CDATA[%dw 2.0
					output application/java
					---
					p('external.azuresql.comms')]]>
				</ee:set-variable>
				<ee:set-variable variableName="userId"><![CDATA[%dw 2.0
					output application/java
					---
					if (lower(attributes.headers.'userId') == p('account.dummy.userId')) vars.clientId else lower(attributes.headers.'userId') ]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="StartLog" doc:id="a411cf26-e2c9-4ada-9bd6-f94feed6c81b" name="commonLoggingEntrySubFlow" />
		<flow-ref doc:name="CheckUserDetails" doc:id="cdbadf73-5f25-44a4-8c32-37bb71d4ed78" name="userDetailsSubFlow" target="userIdDetails" />
		<ee:transform doc:name="GetTcAgreementListReq" doc:id="00415725-c1e8-4ad2-8793-60ca4cead40a">
			<ee:variables>
				<ee:set-variable variableName="dynamicQuery"><![CDATA[%dw 2.0
					import sortQuery from dwl::modules
					output application/java
					var query = p('db.query.select.tcAgreementList')
					var status = if (!isEmpty(attributes.queryParams.*"status")) ( "docAg.STATUS IN ('" ++ (attributes.queryParams.*"status"  joinBy  ("','")) ++ "')" )
					else ( "docAg.STATUS IN ('ACTIVE','INACTIVE')" )
					var title = if (!isBlank(attributes.queryParams."messageQuery"))("AND (docAg.TITLE LIKE '%" ++ (attributes.queryParams."messageQuery")
					++ "%' OR docAg.DOC_AGR_ID LIKE '%" ++ (attributes.queryParams."messageQuery") ++ "%')") else ''
					var serviceType = if (!isEmpty(attributes.queryParams.*"serviceType")) ( "AND (" ++
					((attributes.queryParams.*"serviceType" reduce ((item, acc=[]) -> acc + ("SERVICE_TYPE LIKE '%" ++ item ++ "%'"))) joinBy " OR ") ++ ")" ) else ''
					var updatedBy = if (!isEmpty(attributes.queryParams.*"updatedBy")) ( "AND docAg.UPDATED_BY IN ('" ++ (attributes.queryParams.*"updatedBy"
					joinBy  ("','")) ++ "')" ) else ''
					var sortBy = if (!isEmpty(attributes.queryParams.*"sortBy")) (attributes.queryParams.*"sortBy") else []
					var sortType = if (!isBlank(attributes.queryParams."sortType")) (upper(attributes.queryParams."sortType")) else 'DESC'
					var sortValue = sortQuery(sortBy,sortType,'getTcAgreements')
					---
					(((((query replace ':messageQuery' with(title)) replace ':status' with(status)) replace ':serviceType' with(serviceType)) replace ':updatedBy' with(updatedBy)) replace ':sortQuery' with(sortValue))]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="StartDurationLog" doc:id="da066beb-9119-41b8-9dd0-783addb4729f" name="startDurationLogSubFlow" />
		<db:select doc:name="GetTcAgreementList" doc:id="4099c85b-6311-45df-bc25-9dbe12039a4f" config-ref="azureSqlDatabaseConfig">
			<db:sql><![CDATA[#[vars.dynamicQuery]]]></db:sql>
			<db:input-parameters><![CDATA[#[{
				offset: vars.pagination.offset - 1,
				limit: vars.pagination.limit,
			}]]]>
			</db:input-parameters>
		</db:select>
		<flow-ref doc:name="EndDurationLog" doc:id="f537f61e-5260-493b-a94b-c96a4e9c4d7b" name="endDurationLogSubFlow" />
		<ee:transform doc:name="GetTcAgreementListRes" doc:id="559a7744-caf5-42ad-aac1-4ac71056317c">
			<ee:message>
				<ee:set-payload resource="dwl/content/tcAgreementsListRes.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="logMsg" resource="dwl/logMsg.dwl" />
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="ResLog" doc:id="56a2a0fb-817f-4733-865d-7c53532d6d30" name="commonLoggingExitSubFlow" />
	</sub-flow>

