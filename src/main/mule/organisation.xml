				COUNTRY: dwl::modules::replaceSqlSingleQuotes(vars.apiRequest.branchDetailsRequest.address.country),
				CONTACT_NUMBER: vars.apiRequest.branchDetailsRequest.contactNumber,
				SERVICE: vars.apiRequest.branchDetailsRequest.serviceRoles.service joinBy  "|" ,
				V_SERVICE_ROLE: vars.tvpCreateBranch
			}]]]>
