		<db:stored-procedure doc:name="BranchList" doc:id="604d0770-064c-493d-8ee0-8eb8c5ce0e4b" config-ref="azureSqlDatabaseConfig">
			<db:sql><![CDATA[${db.query.sp.orgBranchList}]]></db:sql>
			<db:input-parameters><![CDATA[#[{
				USER_ID: vars.userIdDetails.userId[0],
				ORG_ID: vars.orgId,
				STATUS: vars.branchParams.status,
				SERVICE: vars.branchParams.service,
				ISSORTFILTER: if (!isBlank(vars.branchParams.sortBy)) 1 else 0,
				SORTCOLUMNS: vars.branchParams.sortBy default null,
				ISKEYWORDSEARCH: if (!isBlank(vars.branchParams.messageQuery)) 1 else 0,
				KEYWORDSEARCH: vars.searchFilter.searchCol as String default null,
				OFFSET:vars.pagination.offset - 1,
				LIMIT: vars.pagination.limit
			}]]]>
